# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files
*.sql text eol=lf
*.md text
*.py text

# Declare binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary

# Jupyter notebooks — treat as docs so SQL/Python/R show in language stats
*.ipynb linguist-documentation

# Make sure SQL is counted in language stats
*.sql linguist-detectable=true

# GitHub Pages configuration files
docs/*.yml text
